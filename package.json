{
  "name": "markup",
  "version": "0.1.0",
  "description": "Local-first MCP server + browser viewer that adds a universal annotation overlay to any agent-generated HTML, with auto-routed feedback via MCP.",
  "author": "Aman",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "markup": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "mcp": "tsx src/index.ts --mcp",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
